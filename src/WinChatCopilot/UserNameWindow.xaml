<local:RetroWindow x:Class="WinChatCopilot.UserNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinChatCopilot"
        Title="User Name" Width="460" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource RetroWindowStyle}">
    <local:RetroWindow.Resources>
        <ResourceDictionary Source="RetroTheme.xaml" />
    </local:RetroWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Content="_User name:" Target="{Binding ElementName=NameInput}" Padding="0,0,0,6" />
        <TextBox x:Name="NameInput" Grid.Row="1" AutomationProperties.Name="User name"
                 AcceptsReturn="False" AcceptsTab="False" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" />
        <ScrollViewer Grid.Row="2" Margin="0,8" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="_OK" local:ButtonIcon.Source="{StaticResource ConfirmIcon}"
                    Width="80" IsDefault="True" Click="SaveClicked" />
            <Button x:Name="CancelButton" Content="_Cancel" local:ButtonIcon.Source="{StaticResource CancelIcon}"
                    MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</local:RetroWindow>

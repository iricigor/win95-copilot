<local:RetroWindow x:Class="WinChatCopilot.MainWindow" x:Name="ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinChatCopilot"
        Height="520" Width="800" MinHeight="340" MinWidth="520"
        Style="{DynamicResource RetroWindowStyle}">
    <local:RetroWindow.Resources>
        <ResourceDictionary Source="RetroTheme.xaml" />
    </local:RetroWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu">
            <MenuItem Header="_File">
                <MenuItem Header="_Save Transcript..." Command="{x:Static local:ShellCommands.SaveTranscript}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <MenuItem Header="_Clear Window" Command="{x:Static local:ShellCommands.ClearWindow}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{x:Static SystemCommands.CloseWindowCommand}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{x:Static local:ShellCommands.Copy}" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{x:Static local:ShellCommands.Paste}" />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{x:Static local:ShellCommands.SelectAll}" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem x:Name="SendEnterMenu" Header="Send with _Enter" IsCheckable="True" Command="{x:Static local:ShellCommands.SendWithEnter}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <MenuItem x:Name="SendControlEnterMenu" Header="Send with _Ctrl+Enter" IsCheckable="True" Command="{x:Static local:ShellCommands.SendWithControlEnter}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <Separator />
                <MenuItem x:Name="WordWrapMenu" Header="_Word Wrap" IsCheckable="True" Command="{x:Static local:ShellCommands.WordWrap}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <MenuItem x:Name="AutoConnectMenu" Header="_Auto-connect on Startup" IsCheckable="True" Command="{x:Static local:ShellCommands.AutoConnect}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <MenuItem x:Name="TimestampMenu" Header="Show _Timestamp" IsCheckable="True" Command="{x:Static local:ShellCommands.ShowTimestamp}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <Separator />
                <MenuItem x:Name="FontMenu" Header="_Font" />
                <MenuItem Header="_User Name..." Command="{x:Static local:ShellCommands.UserName}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <MenuItem Header="_Backend Settings..." Command="{x:Static local:ShellCommands.ConfigureBackend}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About WinChat-Copilot..." Command="{x:Static local:ShellCommands.About}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
            </MenuItem>
        </Menu>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6">
            <Button Content="_Connect" local:ButtonIcon.Source="{StaticResource ConnectIcon}"
                    Command="{x:Static local:ShellCommands.Connect}" Margin="0,0,6,0"
                    CommandTarget="{Binding ElementName=ShellWindow}" />
            <Button Content="_Settings..." local:ButtonIcon.Source="{StaticResource SettingsIcon}"
                    Command="{x:Static local:ShellCommands.ConfigureBackend}" Margin="0,0,6,0"
                    CommandTarget="{Binding ElementName=ShellWindow}" />
            <Button Content="_Help" local:ButtonIcon.Source="{StaticResource HelpIcon}" Command="{x:Static local:ShellCommands.About}"
                    CommandTarget="{Binding ElementName=ShellWindow}" />
        </StackPanel>
        <local:TranscriptView x:Name="Transcript" Grid.Row="2" Margin="8,0,8,6" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" ContextMenu="{x:Null}"
                 AutomationProperties.Name="Transcript" />
        <Grid Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="PromptInput" Height="84" AcceptsReturn="True" TextWrapping="NoWrap"
                     TextChanged="OnPromptChanged" PreviewKeyDown="OnPromptKeyDown"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Message input" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button x:Name="SendButton" Content="_SEND" local:ButtonIcon.Source="{StaticResource SendIcon}"
                        MinWidth="80" Command="{x:Static local:ShellCommands.Send}"
                        CommandTarget="{Binding ElementName=ShellWindow}" />
                <Button x:Name="StopButton" Content="S_top" local:ButtonIcon.Source="{StaticResource StopIcon}"
                        MinWidth="80" Margin="0,6,0,0"
                        ToolTip="Cancel this request and preserve its partial response. No automatic retry."
                        Command="{x:Static local:ShellCommands.Stop}"
                        CommandTarget="{Binding ElementName=ShellWindow}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="4" BorderBrush="#808080" BorderThickness="1,1,0,0" Margin="3,0,3,3">
            <Border BorderBrush="White" BorderThickness="0,0,1,1">
                <StackPanel>
                    <TextBlock x:Name="BackendStatus" Margin="4,3"
                               Text="Backend unavailable - not connected." />
                    <TextBlock x:Name="FontStatus" Margin="4,0,4,3" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</local:RetroWindow>

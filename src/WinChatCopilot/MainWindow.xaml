<local:RetroWindow x:Class="WinChatCopilot.MainWindow" x:Name="ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinChatCopilot"
        Height="520" Width="800" MinHeight="340" MinWidth="520"
        Style="{DynamicResource RetroWindowStyle}">
    <local:RetroWindow.Resources>
        <ResourceDictionary Source="RetroTheme.xaml" />
    </local:RetroWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu">
            <MenuItem Header="_File">
                <MenuItem Header="_Save Transcript..." IsEnabled="False" Command="{x:Static local:ShellCommands.SaveTranscript}" />
                <MenuItem Header="_Clear Window" IsEnabled="False" Command="{x:Static local:ShellCommands.ClearWindow}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{x:Static SystemCommands.CloseWindowCommand}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" IsEnabled="False" Command="{x:Static local:ShellCommands.Copy}" />
                <MenuItem Header="_Paste" IsEnabled="False" Command="{x:Static local:ShellCommands.Paste}" />
                <MenuItem Header="Select _All" IsEnabled="False" Command="{x:Static local:ShellCommands.SelectAll}" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="Send with _Enter" IsEnabled="False" IsCheckable="True" Command="{x:Static local:ShellCommands.SendWithEnter}" />
                <MenuItem Header="Send with _Ctrl+Enter" IsEnabled="False" IsCheckable="True" Command="{x:Static local:ShellCommands.SendWithControlEnter}" />
                <Separator />
                <MenuItem Header="_Word Wrap" IsEnabled="False" IsCheckable="True" Command="{x:Static local:ShellCommands.WordWrap}" />
                <MenuItem x:Name="AutoConnectMenu" Header="_Auto-connect on Startup" IsCheckable="True" Command="{x:Static local:ShellCommands.AutoConnect}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
                <MenuItem Header="Show _Timestamp" IsEnabled="False" IsCheckable="True" Command="{x:Static local:ShellCommands.ShowTimestamp}" />
                <Separator />
                <MenuItem Header="_Backend Settings..." Command="{x:Static local:ShellCommands.ConfigureBackend}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About WinChat-Copilot..." Command="{x:Static local:ShellCommands.About}"
                          CommandTarget="{Binding ElementName=ShellWindow}" />
            </MenuItem>
        </Menu>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6">
            <Button Content="_Connect" Command="{x:Static local:ShellCommands.Connect}" Margin="0,0,6,0"
                    CommandTarget="{Binding ElementName=ShellWindow}" />
            <Button Content="_Settings..." Command="{x:Static local:ShellCommands.ConfigureBackend}" Margin="0,0,6,0"
                    CommandTarget="{Binding ElementName=ShellWindow}" />
            <Button Content="_Help" Command="{x:Static local:ShellCommands.About}"
                    CommandTarget="{Binding ElementName=ShellWindow}" />
        </StackPanel>
        <TextBox x:Name="Transcript" Grid.Row="2" Margin="8,0,8,6" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" ContextMenu="{x:Null}"
                 AutomationProperties.Name="Transcript" />
        <Grid Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="PromptInput" Height="84" AcceptsReturn="True" TextWrapping="NoWrap"
                     TextChanged="OnPromptChanged"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Message input" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button x:Name="SendButton" Content="_SEND" MinWidth="80" Command="{x:Static local:ShellCommands.Send}"
                        CommandTarget="{Binding ElementName=ShellWindow}" />
                <Button x:Name="StopButton" Content="S_top" IsEnabled="False" MinWidth="80" Margin="0,6,0,0"
                        ToolTip="Stop will be implemented with cancellation controls. Exit settles the owned request."
                        Command="{x:Static local:ShellCommands.Stop}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="4" BorderBrush="#808080" BorderThickness="1,1,0,0" Margin="3,0,3,3">
            <Border BorderBrush="White" BorderThickness="0,0,1,1">
                <TextBlock x:Name="BackendStatus" Margin="4,3"
                           Text="Backend unavailable - not connected." />
            </Border>
        </Border>
    </Grid>
</local:RetroWindow>

<local:RetroWindow x:Class="WinChatCopilot.BackendSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinChatCopilot"
        Title="Backend Settings" Width="570" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource RetroWindowStyle}">
    <local:RetroWindow.Resources>
        <ResourceDictionary Source="RetroTheme.xaml" />
    </local:RetroWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Select the actual Copilot executable, or leave blank for discovery."
                   TextWrapping="Wrap" />
        <Grid Grid.Row="1" Margin="0,8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="ExecutableInput" AutomationProperties.Name="Executable path" />
            <Button Grid.Column="1" Content="_Browse..." local:ButtonIcon.Source="{StaticResource BrowseIcon}"
                    Click="BrowseClicked" Margin="8,0,0,0" />
        </Grid>
        <CheckBox x:Name="AutoConnectInput" Grid.Row="2" Content="_Auto-connect on Startup" />
        <TextBlock Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Requires the verified bundled CLI 1.0.81, existing Copilot login, entitlement and network. Connect sends a small text-only readiness request. This app does not install, update, sign in, or store credentials." />
        <TextBlock x:Name="ValidationMessage" Grid.Row="4" Margin="0,8" TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_OK" local:ButtonIcon.Source="{StaticResource ConfirmIcon}" Width="80" IsDefault="True" Click="SaveClicked" />
            <Button Content="_Cancel" local:ButtonIcon.Source="{StaticResource CancelIcon}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</local:RetroWindow>
